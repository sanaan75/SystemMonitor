<Window x:Class="SystemMonitor.DesktopWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemMonitor.DesktopWidget.Controls"
        Title="System Monitor"
        Width="320"
        Height="370"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False">
  <Window.Resources>
    <Style x:Key="CloseButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#FFD8DBE6" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFF525D" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#FFE52E3C" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem x:Name="StartWithWindowsMenuItem" Header="Start with Windows" IsCheckable="True" Click="StartWithWindowsMenuItem_Click" />
      <Separator />
      <MenuItem Header="Hide widget" Click="HideWidget_Click" />
      <MenuItem Header="Exit" Click="Exit_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Border BorderBrush="#72FFFFFF" BorderThickness="1" CornerRadius="18" Padding="14">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C91A2031" Offset="0" />
        <GradientStop Color="#B5232C43" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.42" Color="#FF050710" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="100" />
        <RowDefinition Height="6" />
        <RowDefinition Height="84" />
        <RowDefinition Height="6" />
        <RowDefinition Height="80" />
        <RowDefinition Height="6" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="SYSTEM MONITOR" Foreground="#FFF2F1FF" FontSize="14" FontWeight="Bold" />
          <TextBlock Text="Sanaan Sohrabi Panah" Foreground="#FFFFD34E" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="×" Width="26" Height="26" FontSize="19" FontWeight="Light"
                Style="{StaticResource CloseButtonStyle}" Cursor="Hand" ToolTip="Hide to notification area" Click="HideWidget_Click" />
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#76252B40" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CPU" Foreground="#FF8DE9B3" FontSize="11" FontWeight="SemiBold" />
            <TextBlock x:Name="CpuValue" Text="0%" Foreground="#FFF4F3FA" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,1" />
            <controls:SegmentedProgressBar x:Name="CpuBar" Height="14" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#76252B40" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="MEMORY" Foreground="#FF8DE9B3" FontSize="11" FontWeight="SemiBold" />
            <TextBlock x:Name="MemoryPercent" Text="0%" Foreground="#FFF4F3FA" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" />
            <controls:SegmentedProgressBar x:Name="MemoryBar" Height="14" Margin="0,1,0,1" />
            <TextBlock x:Name="MemoryUsed" Text="— / —" Foreground="#FF9A9DB1" FontSize="9" Margin="0,1,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="4" Background="#76252B40" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="GPU" Foreground="#FF8DE9B3" FontSize="11" FontWeight="SemiBold" />
            <TextBlock x:Name="GpuPercent" Text="—" Foreground="#FFF4F3FA" FontSize="11" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="3D ENGINE" Foreground="#FF85899F" FontSize="9" />
              <TextBlock Text="Overall utilization" Foreground="#FFE9E8F1" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
              <TextBlock Text="DEDICATED MEMORY" Foreground="#FF85899F" FontSize="9" HorizontalAlignment="Right" />
              <TextBlock x:Name="GpuMemory" Text="—" Foreground="#FFE9E8F1" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="6" Background="#76252B40" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="NETWORK" Foreground="#FF8DE9B3" FontSize="11" FontWeight="SemiBold" />
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↓" Foreground="#FF42D98A" FontSize="19" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RECEIVED" Foreground="#FF85899F" FontSize="9" />
                <TextBlock x:Name="NetworkDown" Text="0 B/s" Foreground="#FFE9E8F1" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="↑" Foreground="#FF42D98A" FontSize="19" VerticalAlignment="Center" Margin="0,0,8,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SENT" Foreground="#FF85899F" FontSize="9" />
                <TextBlock x:Name="NetworkUp" Text="0 B/s" Foreground="#FFE9E8F1" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <TextBlock x:Name="UpdatedAt" Grid.Row="8" Text="Starting…" Foreground="#FF85899F" FontSize="10" VerticalAlignment="Center" />
    </Grid>
  </Border>
</Window>
